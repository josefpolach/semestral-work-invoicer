<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Invoicing.App.ViewModels"
        xmlns:views="using:Invoicing.App.Views"
        x:Class="Invoicing.App.Views.MessageWindow" x:DataType="vm:MessageViewModel" Title="Fakturace" Width="470" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">

  <StackPanel Margin="24" Spacing="18">
    <TextBlock Classes="message" Text="{Binding Message}" />
    <StackPanel Spacing="8" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Ne" IsVisible="{Binding Confirm}" Click="CloseNegative" />
      <Button Classes="accent" Content="Ano" IsVisible="{Binding Confirm}" Click="ClosePositive" />
      <Button Classes="accent" Content="OK" IsVisible="{Binding !Confirm}" Click="ClosePositive" />
    </StackPanel>
  </StackPanel>
</Window>
