<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Invoicing.App.ViewModels"
        xmlns:views="using:Invoicing.App.Views"
        x:Class="Invoicing.App.Views.ErrorWindow" x:DataType="vm:ErrorViewModel" Title="Aplikaci nelze spustit" Width="580" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterScreen">

  <StackPanel Margin="24" Spacing="14">
    <TextBlock Classes="heading" Text="Aplikaci nelze spustit" />
    <TextBlock Classes="message" Text="{Binding Errors}" />
    <TextBlock Classes="message" Text="{Binding Help}" />
    <Button Classes="accent" Content="OK" HorizontalAlignment="Right" Click="CloseWindow" />
  </StackPanel>
</Window>
